<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP sin cifrar SOLO hacia el ESP32 en la red local.
  Android no admite rangos de IP aquí. Si cambias la IP del ESP32,
  usa el script set-ip de app/package.json (ver README) y recompila.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- pickled:hosts -->
        <domain includeSubdomains="false">pickled.local</domain>
        <domain includeSubdomains="false">192.168.1.50</domain>
        <!-- /pickled:hosts -->
    </domain-config>
</network-security-config>
