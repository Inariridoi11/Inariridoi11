    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/material-symbols-rounded": "^5.3.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
